PORT=3000

# Local dev uses .env when any SQL_* is set (appsettings.json is ignored).
# Force legacy appsettings: SQL_USE_APPSETTINGS=true

# --- Windows dev + live DB via SSH tunnel (deploy/tunnel-live-sql.ps1) ---
# SQL_SERVER=127.0.0.1
# SQL_PORT=14333
# SQL_ENCRYPT=false
# SQL_TRUST_SERVER_CERTIFICATE=true

SQL_SERVER=your_sql_server_host
SQL_PORT=1433
SQL_DATABASE=FaizanIslamicSchool
SQL_USER=your_sql_user
SQL_PASSWORD=your_sql_password
SQL_ENCRYPT=true
SQL_TRUST_SERVER_CERTIFICATE=true

JWT_SECRET=change-me-to-a-long-random-string

CORS_ORIGINS=http://127.0.0.1:3000
