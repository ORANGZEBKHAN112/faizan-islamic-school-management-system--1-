# Database Configuration (replace with your own values)
# Remote SQL Server (SQL auth):
# SQL_USER=your_sql_user
# SQL_PASSWORD=your_sql_password
# SQL_SERVER=your_sql_server_host
# SQL_PORT=1433
# SQL_DATABASE=your_database_name

# Local SQL Server LocalDB (Windows Integrated Security):
# SQL_SERVER=(localdb)\MSSQLLocalDB
# SQL_DATABASE=FaizanIslamincDb
# SQL_DRIVER=msnodesqlv8
# SQL_ENCRYPT=false
# SQL_TRUST_SERVER_CERTIFICATE=false
# SQL_TRUSTED_CONNECTION=true

SQL_USER=your_sql_user
SQL_PASSWORD=your_sql_password
SQL_SERVER=your_sql_server_host
SQL_PORT=1433
SQL_DATABASE=your_database_name
SQL_ENCRYPT=true
SQL_TRUST_SERVER_CERTIFICATE=true

# Auth (required in production; use a long random string)
JWT_SECRET=change-me-to-a-long-random-string

# Optional: comma-separated allowed origins (defaults to http://localhost:3000)
# CORS_ORIGINS=http://localhost:3000,https://your-domain.com

# Kuickpay BPS credentials and consumer prefix are stored in QuickPayConfig (UI: Kuickpay setup).
# Public endpoints Kuickpay calls (no JWT): POST /api/v1/BillInquiry, POST /api/v1/BillPayment
# Share your public HTTPS origin + those paths with Kuickpay; auth via username/password HTTP headers.
