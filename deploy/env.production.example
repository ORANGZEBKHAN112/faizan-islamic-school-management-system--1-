# Copy to /var/www/fiss-erp/.env on the VPS (never commit real .env)
#
# Do NOT put NODE_ENV=production in this file — Vite rejects it during `npm run build`.
# PM2 (deploy/pm2/ecosystem.config.cjs) and start:prod already set NODE_ENV=production.
PORT=3000

# On the VPS app server, SQL is usually on the same machine:
SQL_SERVER=127.0.0.1
SQL_PORT=1433
SQL_DATABASE=FaizanIslamicSchool
SQL_USER=sa
SQL_PASSWORD=your_sql_password
SQL_ENCRYPT=false
SQL_TRUST_SERVER_CERTIFICATE=true
#
# From a Windows PC: do NOT copy 127.0.0.1 blindly (that is your PC).
# Use: powershell -File deploy/tunnel-live-sql.ps1
# then local .env SQL_SERVER=127.0.0.1 SQL_PORT=14333 with the same DB/user/password.

# Required in production — generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# Optional — only if browser origin differs from API origin
# CORS_ORIGINS=https://erp.yourschool.pk
